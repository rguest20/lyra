{"details":{"evidence_match":{"method":"exact","original_passage_span":"Oganesson is a synthetic chemical element; it has symbol Og and atomic number 118.","passage_byte_start":0,"proposed_evidence":"Oganesson is a synthetic chemical element; it has symbol Og and atomic number 118.","proposed_evidence_chars":82},"initial_reason":"AI semantic entailment confirmed against original source quotation","initial_status":"accepted","model_output_excerpt":"{\n  \"claim\": {\n    \"subject\": \"Oganesson\",\n    \"relation\": \"is\",\n    \"object\": \"a synthetic chemical element\",\n    \"evidence_text\": \"Oganesson is a synthetic chemical element; it has symbol Og and atomic number 118.\",\n    \"confidence\": 0.98,\n    \"question_relevance\": \"direct\",\n    \"valid_from\": null,\n    \"valid_until\": null\n  }\n}","question":"Find reliable evidence that supports, contradicts, or qualifies this assertion: Oganesson is a synthetic element.","reason":"AI semantic entailment confirmed against original source quotation","relevance":"direct","review_guidance":null,"selected_passage_chars":720,"selected_passage_excerpt":"Oganesson is a synthetic chemical element; it has symbol Og and atomic number 118.\nIn December 2015, it was recognized as one of four new elements by the Joint Working Party of the international scientific bodies IUPAC and IUPAP.\nThe name honors the nuclear physicist Yuri Oganessian, who played a leading role in the discovery of the heaviest elements in the periodic table.\nOganesson has the highest atomic number and highest atomic mass of all known elements.\nOn the periodic table of the elements it is a p-block element, a member of group 18, and the last member of period 7.\nIts only known isotope, oganesson-294, is highly radioactive, with a half-life of 0.7 ms.\nThis half-life is too short for chemical studies.","selected_passage_truncated":false,"semantic_support":{"evidence_text":"Oganesson is a synthetic chemical element; it has symbol Og and atomic number 118.","model_verdict":"entailed","object":"a synthetic chemical element","reason":"The source explicitly states Oganesson is a synthetic chemical element.","relation":"is","stance_override":null,"subject":"Oganesson","valid_from":null,"valid_until":null,"verdict":"entailed"},"source_title":"Oganesson","status":"accepted"},"event":"scholar.extraction_decision","ts_unix_ms":1791233593138}
